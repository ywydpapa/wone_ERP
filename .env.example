# ==============================================================================
# WONE ERP 환경 설정 가이드 (.env)
# ==============================================================================

# [보안 키 설정 (필수)]
# 세션 암호화 키 (임의의 긴 문자열)
SESSION_SECRET_KEY=wone-erp-session-secret-key-change-this-in-production

# 주민등록번호 Fernet 대칭키 (필수)
# 생성 방법: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ERP_RNO_KEY=dZtI0HrOpAJBsjNYmgRF54TVg1H59OgeI4LGWXaLpLg=

# [데이터베이스 설정]
# DB_ENGINE: 'mariadb' (운영/권장) 또는 'sqlite' (로컬 간이 개발용)
DB_ENGINE=mariadb

# MariaDB 연결 정보 (DB_ENGINE=mariadb 일 때 적용)
DB_HOST=becog.iptime.org
DB_PORT=3306
DB_USER=woneuser
DB_PASSWORD=Core2025%
DB_NAME=wone
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# SQLite 파일 경로 (DB_ENGINE=sqlite 일 때만 사용)
# DB_PATH=erp.db

# [서버 및 세션 설정]
# ENV: development 또는 production
ENV=development
# 세션 유휴 타임아웃 (초 단위, 기본 1800초 = 30분)
IDLE_TIMEOUT=1800

# [음성 및 AI 모델 디렉토리 (선택)]
TTS_DIR=models/supertonic
